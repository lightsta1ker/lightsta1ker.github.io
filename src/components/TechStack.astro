---
const stack = {
  "Infrastructure Layer": [
    { 
      name: "AWS", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-original-wordmark.svg", 
      insight: "The infinite computer.", 
      url: "https://aws.amazon.com",
      snippet: `resource "aws_instance" "web" {
  ami           = "ami-0c55b159cbfafe1f0"
  instance_type = "t3.medium"
  tags = { Name = "Prod-Web" }
}`
    },
    { 
      name: "Terraform", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/terraform/terraform-original.svg", 
      insight: "Infrastructure as state.", 
      url: "https://www.terraform.io",
      snippet: `module "vpc" {
  source = "terraform-aws-modules/vpc/aws"
  version = "5.0.0"
  name = "main-vpc"
  cidr = "10.0.0.0/16"
}`
    },
    { 
      name: "Google Cloud", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg", 
      insight: "Great networking.", 
      url: "https://cloud.google.com",
      snippet: `resource "google_compute_network" "vpc" {
  name                    = "main-network"
  auto_create_subnetworks = false
}`
    },
    { 
      name: "Bash", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bash/bash-original.svg", 
      insight: "The glue.", 
      url: "https://www.gnu.org/software/bash/",
      snippet: `#!/bin/bash
for pod in $(kubectl get pods -n prod); do
  echo "Checking health: $pod"
  kubectl logs $pod --tail=20
done`
    }
  ],
  "Platform Layer": [
    { 
      name: "Kubernetes", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-plain.svg", 
      insight: "The OS of the cloud.", 
      url: "https://kubernetes.io",
      snippet: `apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-server
spec:
  replicas: 3
  selector:
    matchLabels:
      app: api`
    },
    { 
      name: "Docker", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg", 
      insight: "Works on my machine.", 
      url: "https://www.docker.com",
      snippet: `FROM node:18-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
CMD ["npm", "start"]`
    },
    { 
      name: "Helm", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/helm/helm-original.svg", 
      insight: "Package management.", 
      url: "https://helm.sh",
      snippet: `apiVersion: helm.toolkit.fluxcd.io/v2beta1
kind: HelmRelease
metadata:
  name: redis
spec:
  interval: 5m
  chart:
    spec:
      chart: redis`
    },
    { 
      name: "ArgoCD", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/argocd/argocd-original.svg", 
      insight: "No drift allowed.", 
      url: "https://argo-cd.readthedocs.io",
      snippet: `apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: guestbook
spec:
  destination:
    server: https://k8s.cluster.local
  source:
    path: guestbook`
    },
    { 
      name: "GitHub Actions", 
      icon: "https://cdn.simpleicons.org/githubactions/2088ff", 
      insight: "CI where code lives.", 
      url: "https://github.com/features/actions",
      snippet: `name: CI
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - run: npm test`
    }
  ],
  "Observability & Logic": [
    { 
      name: "Prometheus", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/prometheus/prometheus-original.svg", 
      insight: "Metrics everywhere.", 
      url: "https://prometheus.io",
      snippet: `groups:
- name: example
  rules:
  - alert: HighErrorRate
    expr: job:errors > 0.5
    for: 10m
    labels:
      severity: page`
    },
    { 
      name: "Grafana", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/grafana/grafana-original.svg", 
      insight: "Pretty charts.", 
      url: "https://grafana.com",
      snippet: `{
  "panels": [
    {
      "type": "graph",
      "title": "Requests/sec",
      "targets": [{ "expr": "rate(http_reqs[5m])" }]
    }
  ]
}`
    },
    { 
      name: "Go", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original-wordmark.svg", 
      insight: "Fast & simple.", 
      url: "https://go.dev",
      snippet: `func main() {
    http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
        fmt.Fprintf(w, "Hello, Cloud Native!")
    })
    log.Fatal(http.ListenAndServe(":8080", nil))
}`
    },
    { 
      name: "Python", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg", 
      insight: "Versatile.", 
      url: "https://www.python.org",
      snippet: `import boto3
s3 = boto3.resource('s3')
for bucket in s3.buckets.all():
    print(bucket.name)`
    },
    { 
      name: "Node.js", 
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg", 
      insight: "Async everywhere.", 
      url: "https://nodejs.org",
      snippet: `const http = require('http');
http.createServer((req, res) => {
  res.writeHead(200);
  res.end('System Healthy');
}).listen(3000);`
    }
  ]
};

const allIcons = Object.values(stack).flat();
---

<section id="stack" class="pt-24 pb-0 relative z-30 overflow-hidden mb-0">
  <h2 class="text-3xl font-bold mb-12 flex items-center gap-4 relative z-10">
    <span class="text-accent-primary">02.</span> 
    Infrastructure Topology
    <span class="h-px bg-console-border flex-1 ml-4"></span>
  </h2>

  <div class="relative w-full group pointer-events-none mx-auto max-w-6xl">
    
    <!-- Left Arrow -->
    <button id="marquee-prev" class="absolute left-0 top-0 bottom-0 z-30 w-16 flex items-center justify-center text-accent-primary/50 hover:text-accent-primary transition-colors pointer-events-auto">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>

    <!-- Right Arrow -->
    <button id="marquee-next" class="absolute right-0 top-0 bottom-0 z-30 w-16 flex items-center justify-center text-accent-primary/50 hover:text-accent-primary transition-colors pointer-events-auto">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>

    <div class="flex space-x-20 py-12 px-16 select-none pointer-events-auto overflow-visible" id="marquee-container">
      <div id="marquee-track" class="flex space-x-20">
        {[...allIcons, ...allIcons].map((skill) => (
          <div class="flex-shrink-0 relative group/icon">
            <a 
              href={skill.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex flex-col items-center gap-5 transition-all duration-300 hover:scale-125"
            >
              <img 
                src={skill.icon} 
                alt={skill.name} 
                class="w-24 h-24 object-contain filter drop-shadow-[0_0_2px_rgba(255,255,255,0.2)] group-hover/icon:drop-shadow-[0_0_20px_rgba(0,240,255,0.8)] transition-all" 
              />
              <span class="text-sm font-mono text-console-muted group-hover/icon:text-white transition-colors">{skill.name}</span>
            </a>

            <!-- Code Dialogue Box (Dropdown) -->
            <div class="absolute top-full left-1/2 -translate-x-1/2 mt-8 w-80 opacity-0 scale-95 group-hover/icon:opacity-100 group-hover/icon:scale-100 transition-all duration-300 pointer-events-none group-hover/icon:pointer-events-auto z-[100]">
              <div class="relative border border-console-border bg-console-bg/95 backdrop-blur-xl p-5 rounded-lg font-mono text-[11px] text-console-muted shadow-2xl shadow-accent-primary/20">
                <div class="flex gap-2 mb-4 border-b border-console-border pb-2 justify-between items-center">
                  <span class="text-accent-primary">{skill.name.toLowerCase()}.yaml</span>
                  <div class="flex gap-1.5">
                    <div class="w-2 h-2 rounded-full bg-red-500/40"></div>
                    <div class="w-2 h-2 rounded-full bg-yellow-500/40"></div>
                    <div class="w-2 h-2 rounded-full bg-green-500/40"></div>
                  </div>
                </div>
                <pre class="overflow-x-auto leading-relaxed text-console-muted/90"><code>{skill.snippet}</code></pre>
                
                <div class="mt-4 pt-3 border-t border-console-border/50 flex items-center gap-2">
                  <span class="text-accent-secondary">#</span>
                  <span class="italic text-[10px]">{skill.insight}</span>
                </div>

                <!-- Decorative corner -->
                <div class="absolute -bottom-1 -right-1 w-4 h-4 border-r border-b border-accent-primary/40"></div>
              </div>
              <!-- Arrow (Pointing Up) -->
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 -mb-1 w-4 h-4 bg-console-bg/95 border-l border-t border-console-border rotate-45"></div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
  
  <!-- Spacer for Dropdowns (to prevent clipping if needed, though visible overflow might handle it) -->
  <div class="h-80 w-full"></div>
</section>

</section>

<script>
  function initMarquee() {
    const track = document.getElementById('marquee-track');
    const container = document.getElementById('marquee-container');
    const prevBtn = document.getElementById('marquee-prev');
    const nextBtn = document.getElementById('marquee-next');

    if (!track || !container || !prevBtn || !nextBtn) return;

    // Clone content for seamless scrolling if not already duplicated by Astro
    // (Note: The Astro template already duplicates the array: [...allIcons, ...allIcons])
    // But we need to ensure the width is sufficient. 
    // Current setup works for CSS animation which goes to -50%.
    // For JS, we'll maintain the same logic: scroll from 0 to width/2, then reset to 0.

    let position = 0;
    const speed = 1.5; // Adjusted 2x speed roughly
    let isPaused = false;
    let animationFrameId;

    // Get the width of one set of icons (half the track)
    // We need to wait for images to load ideally, or rely on fixed sizing.
    // Icons are w-24 (96px) + space-x-20 (5rem = 80px)
    // Let's calculate dynamically.
    
    function animate() {
      if (!isPaused) {
        position += speed;
        // Total width of the track (container of all items)
        const trackWidth = track.scrollWidth;
        const halfWidth = trackWidth / 2;

        if (position >= halfWidth) {
          position = 0;
        }
        track.style.transform = `translateX(-${position}px)`;
      }
      animationFrameId = requestAnimationFrame(animate);
    }

    // Start animation
    animate();

    // Pause on hover (arrows or container)
    const pause = () => isPaused = true;
    const resume = () => isPaused = false;

    prevBtn.addEventListener('mouseenter', pause);
    prevBtn.addEventListener('mouseleave', resume);
    nextBtn.addEventListener('mouseenter', pause);
    nextBtn.addEventListener('mouseleave', resume);
    
    // Also pause when hovering the icons themselves? 
    // User asked "if the mouse is over them [arrows], stop the auto scroll".
    // Didn't specify icons, but usually good UX. 
    // The previous CSS had group-hover pause. Let's keep it for the container.
    container.addEventListener('mouseenter', pause);
    container.addEventListener('mouseleave', resume);

    // Click handlers
    // "clicking on either arrow should scroll to the next set of icons"
    // We'll advance by a significant chunk, e.g., container width or fixed amount.
    const scrollAmount = 400; // pixels to jump

    nextBtn.addEventListener('click', () => {
      position += scrollAmount;
      const trackWidth = track.scrollWidth;
      const halfWidth = trackWidth / 2;
      if (position >= halfWidth) position -= halfWidth; // Wrap logic
      track.style.transform = `translateX(-${position}px)`;
    });

    prevBtn.addEventListener('click', () => {
      position -= scrollAmount;
      const trackWidth = track.scrollWidth;
      const halfWidth = trackWidth / 2;
      if (position < 0) position += halfWidth; // Wrap logic
      track.style.transform = `translateX(-${position}px)`;
    });
  }

  // Run on initial load
  initMarquee();

  // Run on View Transitions navigation
  document.addEventListener('astro:page-load', initMarquee);
</script>
