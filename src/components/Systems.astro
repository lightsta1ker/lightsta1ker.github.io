---
import { getCollection } from 'astro:content';

const systems = await getCollection('systems');
// Sort by date or custom order if needed
systems.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<section id="systems" class="py-20">
  <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
    <span class="text-accent-primary">01.</span> 
    Systems I Build & Operate
    <span class="h-px bg-console-border flex-1 ml-4"></span>
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {systems.map((system, index) => (
      <a href={`/systems/${system.slug}`} class="block console-card group hover:-translate-y-2 transition-all duration-500 hover:shadow-[0_0_30px_rgba(0,240,255,0.1)]" style={`animation-delay: ${index * 200}ms`}>
        <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 bg-console-bg w-16 h-16 flex items-center justify-center rounded-lg border border-console-border group-hover:border-accent-primary/50">
          {system.data.icon}
        </div>
        <h3 class="text-xl font-bold mb-3 text-console-text group-hover:text-accent-primary transition-colors">{system.data.title}</h3>
        <p class="text-console-muted text-sm mb-6 leading-relaxed line-clamp-3">
          {system.data.description}
        </p>
        <div class="flex flex-wrap gap-2">
          {system.data.stats.map(stat => (
            <span class="text-xs font-mono px-2 py-1 rounded bg-console-border/50 text-accent-success border border-console-border group-hover:border-accent-primary/30 transition-colors">
              {stat}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
