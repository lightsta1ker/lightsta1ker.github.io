---
import Terminal from './Terminal.astro';
---

<section class="min-h-[60vh] flex flex-col items-center justify-center py-20 text-center">
  <div class="space-y-8 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-primary/10 border border-accent-primary/20 text-accent-primary text-xs font-mono">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-primary"></span>
      </span>
      System Operational
    </div>
    
    <h1 class="text-5xl lg:text-8xl font-bold tracking-tight">
      Arunachalam <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-primary to-accent-secondary">Thangappa</span>
    </h1>
    <h2 class="text-2xl lg:text-4xl font-mono text-console-text">
      DevOps & Infrastructure Engineer
    </h2>
    
    <p class="text-xl text-console-muted max-w-2xl leading-relaxed mx-auto">
      Designing secure, scalable cloud architectures on AWS. Expert in Kubernetes, Terraform, mTLS implementation, and GitOps workflows. Modernizing legacy infrastructure for fintech and IoT sectors.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 pt-4 justify-center">
      <a href="#projects" class="px-8 py-4 bg-accent-primary text-black font-bold rounded hover:bg-accent-primary/90 transition-colors">
        View Systems
      </a>
      <a href="https://github.com/lightsta1ker" target="_blank" class="px-8 py-4 border border-console-border hover:border-accent-primary text-console-text rounded transition-colors">
        GitHub Profile
      </a>
    </div>
  </div>
</section>
