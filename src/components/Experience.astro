---
const experience = [
  {
    company: "Sedin Technologies",
    role: "DevOps Engineer",
    period: "Nov 2024 - Present",
    narrative: "Working with Toyota Connected to engineer Zero-Trust mTLS architecture for Vehicle-2-Grid (V2G) communication using AWS Private CA and Transit Gateway. Also modernizing IoT infrastructure for UDS (Chennai Metro) by designing EKS-based platforms with EMQX, RDS, and RabbitMQ, and building end-to-end CI/CD pipelines with ArgoCD."
  },
  {
    company: "Tazapay",
    role: "Associate DevOps Engineer",
    period: "Feb 2024 - Oct 2024",
    narrative: "Developed comprehensive Disaster Recovery strategies and fortified payment platform security using WAF rules to neutralize DDoS attacks. Migrated MongoDB Atlas Clusters to self-hosted VPNs and upgraded CI/CD pipelines for semantic versioning. Implemented observability with Sumo Logic and OpenTelemetry."
  },
  {
    company: "ShelfPerks",
    role: "DevOps & Infrastructure Engineer",
    period: "Nov 2022 - Feb 2024",
    narrative: "Containerized cloud-native applications and maintained IaC workflows. Developed a custom domain reseller portal with automated DNS templating. Enhanced data security by migrating databases to self-hosted VPN environments and enabling Private Service Connect."
  },
  {
    company: "ShelfPerks",
    role: "Jr. DevOps Engineer",
    period: "Nov 2021 - Oct 2022",
    narrative: "Automated SSL certificate lifecycle management using cert-manager. Maintained Developer Portals and Internal Operations Platforms. Designed and implemented Billing & Subscriptions services using Stripe APIs and Node.js."
  }
];
---

<section id="experience" class="py-20">
  <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
    <span class="text-accent-primary">04.</span> 
    Architecture Narrative
    <span class="h-px bg-console-border flex-1 ml-4"></span>
  </h2>

  <div class="relative border-l border-console-border ml-3 md:ml-6 space-y-12">
    {experience.map((job, index) => (
      <div class="relative pl-8 md:pl-12">
        <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 rounded-full bg-accent-secondary ring-4 ring-console-bg"></div>
        
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
          <h3 class="text-xl font-bold text-white">{job.role} <span class="text-accent-primary">@ {job.company}</span></h3>
          <span class="font-mono text-sm text-console-muted bg-console-card px-2 py-1 rounded border border-console-border mt-2 sm:mt-0 w-fit">
            {job.period}
          </span>
        </div>
        
        <p class="text-console-muted leading-relaxed max-w-3xl">
          {job.narrative}
        </p>
      </div>
    ))}
  </div>
</section>
