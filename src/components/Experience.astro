---
const experience = [
  {
    company: "Sedin Technologies",
    role: "DevOps Engineer",
    period: "Nov 2024 - Present",
    achievements: [
      "Engineered Zero-Trust mTLS architecture for Vehicle-2-Grid (V2G) communication using AWS Private CA and Transit Gateway.",
      "Modernized IoT infrastructure for UDS (Chennai Metro) by designing EKS-based platforms with EMQX, RDS, and RabbitMQ.",
      "Built end-to-end CI/CD pipelines with ArgoCD."
    ]
  },
  {
    company: "Tazapay",
    role: "Associate DevOps Engineer",
    period: "Feb 2024 - Oct 2024",
    achievements: [
      "Developed comprehensive Disaster Recovery strategies and fortified payment platform security using WAF rules.",
      "Migrated MongoDB Atlas Clusters to self-hosted VPNs and upgraded CI/CD pipelines for semantic versioning.",
      "Implemented observability with Sumo Logic and OpenTelemetry."
    ]
  },
  {
    company: "ShelfPerks",
    role: "DevOps & Infrastructure Engineer",
    period: "Nov 2022 - Feb 2024",
    achievements: [
      "Containerized cloud-native applications and maintained IaC workflows.",
      "Developed a custom domain reseller portal with automated DNS templating.",
      "Enhanced data security by migrating databases to self-hosted VPN environments and enabling Private Service Connect."
    ]
  },
  {
    company: "ShelfPerks",
    role: "Jr. DevOps Engineer",
    period: "Nov 2021 - Oct 2022",
    achievements: [
      "Automated SSL certificate lifecycle management using cert-manager.",
      "Maintained Developer Portals and Internal Operations Platforms.",
      "Designed and implemented Billing & Subscriptions services using Stripe APIs and Node.js."
    ]
  }
];
---

<section id="experience" class="py-20">
  <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
    <span class="text-accent-primary">04.</span> 
    Experience
    <span class="h-px bg-console-border flex-1 ml-4"></span>
  </h2>

  <div class="relative border-l border-console-border ml-3 md:ml-6 space-y-12">
    {experience.map((job, index) => (
      <div class="relative pl-8 md:pl-12">
        <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 rounded-full bg-accent-primary ring-4 ring-console-bg"></div>
        
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-4">
          <h3 class="text-xl font-bold text-white">{job.role}</h3>
          <span class="text-accent-secondary font-mono text-sm">@ {job.company}</span>
          <span class="text-console-muted text-xs font-mono border border-console-border px-2 py-0.5 rounded ml-auto sm:ml-0">
            {job.period}
          </span>
        </div>

        <ul class="space-y-3">
          {job.achievements.map(achievement => (
            <li class="text-console-muted text-sm leading-relaxed flex gap-3">
              <span class="text-accent-primary mt-1">➜</span>
              {achievement}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
```
