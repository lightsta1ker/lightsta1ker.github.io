---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Background from '../components/Background.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "DevOps & Infrastructure Engineer Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/your-code.js" crossorigin="anonymous"></script>
  </head>
  <body class="bg-console-bg text-console-text font-sans antialiased selection:bg-accent-primary/30 selection:text-white">
    <Background />
    <div class="fixed top-0 left-0 w-full h-1 bg-gradient-to-r from-accent-primary via-accent-secondary to-accent-success z-50"></div>
    
    <nav class="border-b border-console-border bg-console-bg/95 backdrop-blur-md sticky top-0 z-40">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded bg-gradient-to-br from-accent-primary to-accent-secondary flex items-center justify-center text-black font-bold font-mono group-hover:scale-105 transition-transform shadow-lg shadow-accent-primary/20">
            AT
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-white leading-none tracking-tight">Arunachalam</span>
            <span class="text-[10px] text-console-muted font-mono">DevOps Engineer</span>
          </div>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="group flex items-center gap-2 text-sm font-medium text-console-muted hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-primary group-hover:scale-110 transition-transform"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Home
          </a>
          <a href="/#stack" class="group flex items-center gap-2 text-sm font-medium text-console-muted hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-secondary group-hover:scale-110 transition-transform"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            Stack
          </a>
          <a href="/#projects" class="group flex items-center gap-2 text-sm font-medium text-console-muted hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-success group-hover:scale-110 transition-transform"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            Projects
          </a>
          <a href="/#experience" class="group flex items-center gap-2 text-sm font-medium text-console-muted hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-warning group-hover:scale-110 transition-transform"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Experience
          </a>
          <a href="/#contact" class="group flex items-center gap-2 text-sm font-medium text-console-muted hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-primary group-hover:scale-110 transition-transform"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Contact
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-console-text hover:text-white hover:bg-console-card rounded transition-colors" aria-label="Toggle menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Mobile Menu Overlay -->
      <div id="mobile-menu" class="hidden md:hidden absolute top-16 left-0 w-full bg-console-bg/95 backdrop-blur-md border-b border-console-border p-4 flex flex-col gap-2 shadow-2xl transform origin-top transition-all duration-200">
        <a href="/" class="mobile-link flex items-center gap-3 p-3 rounded hover:bg-console-card transition-colors text-console-text hover:text-white">
          <div class="p-1.5 rounded bg-accent-primary/10 text-accent-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <span class="font-medium">Home</span>
        </a>
        <a href="/#stack" class="mobile-link flex items-center gap-3 p-3 rounded hover:bg-console-card transition-colors text-console-text hover:text-white">
          <div class="p-1.5 rounded bg-accent-secondary/10 text-accent-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <span class="font-medium">Stack</span>
        </a>
        <a href="/#projects" class="mobile-link flex items-center gap-3 p-3 rounded hover:bg-console-card transition-colors text-console-text hover:text-white">
          <div class="p-1.5 rounded bg-accent-success/10 text-accent-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <span class="font-medium">Projects</span>
        </a>
        <a href="/#experience" class="mobile-link flex items-center gap-3 p-3 rounded hover:bg-console-card transition-colors text-console-text hover:text-white">
          <div class="p-1.5 rounded bg-accent-warning/10 text-accent-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <span class="font-medium">Experience</span>
        </a>
        <a href="/#contact" class="mobile-link flex items-center gap-3 p-3 rounded hover:bg-console-card transition-colors text-console-text hover:text-white">
          <div class="p-1.5 rounded bg-accent-primary/10 text-accent-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <span class="font-medium">Contact</span>
        </a>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8 min-h-[calc(100vh-160px)]">
      <slot />
    </main>

    <footer class="border-t border-console-border bg-console-card/50 backdrop-blur-sm fixed bottom-0 w-full z-50 text-[10px] font-mono text-console-muted">
      <div class="container mx-auto px-4 h-8 flex items-center justify-between">
        <div class="flex gap-4">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-success"></span>
            <span>STATUS: HEALTHY</span>
          </div>
          <div class="hidden sm:block">REGION: ap-south-1</div>
          <div class="hidden sm:block">LATENCY: 24ms</div>
        </div>
        <div class="flex gap-4">
          <div>BUILD: v2.4.0</div>
          <div class="hidden sm:block">UPTIME: 99.99%</div>
        </div>
      </div>
    </footer>

    <!-- Debug Overlay (Hidden by default) -->
    <div id="debug-overlay" class="fixed inset-0 bg-black/90 z-[100] hidden font-mono text-xs p-4 overflow-auto text-green-500">
      <div class="max-w-3xl mx-auto space-y-2">
        <div class="border-b border-green-500/30 pb-2 mb-4 flex justify-between">
          <h2 class="text-xl font-bold">SYSTEM DIAGNOSTICS</h2>
          <button id="close-debug" class="hover:text-white">[CLOSE]</button>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <h3 class="text-white mb-2">KERNEL PANIC LOGS</h3>
            <pre class="opacity-70">
[  0.000000] Linux version 6.8.0-rc1 (arun@devops)
[  0.000000] Command line: BOOT_IMAGE=/vmlinuz root=UUID=...
[  0.004211] Console: colour dummy device 80x25
[  0.004245] printk: console [tty0] enabled
            </pre>
          </div>
          <div>
            <h3 class="text-white mb-2">MEMORY MAP</h3>
            <pre class="opacity-70">
0000000000000000-0000000000099c00 : System RAM
0000000000099c00-00000000000a0000 : Reserved
00000000000e0000-0000000000100000 : Reserved
            </pre>
          </div>
        </div>
        <div class="mt-4">
          <h3 class="text-white mb-2">USER NOTES</h3>
          <p class="opacity-70">> If you found this, you're exactly the kind of engineer I want to work with.</p>
          <p class="opacity-70">> Let's connect: arunachalamthangappa@gmail.com</p>
        </div>
      </div>
    </div>

    <script>
      // Mobile Menu Logic
      function initMobileMenu() {
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        
        if (mobileBtn && mobileMenu) {
          mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            const isExpanded = !mobileMenu.classList.contains('hidden');
            mobileBtn.setAttribute('aria-expanded', isExpanded.toString());
          });

          // Close menu when clicking a link
          mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
              mobileMenu.classList.add('hidden');
            });
          });
        }
      }

      // Run on initial load
      initMobileMenu();

      // Run on View Transitions navigation
      document.addEventListener('astro:page-load', initMobileMenu);

      // Easter Egg: ?debug=true
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('debug') === 'true') {
        document.getElementById('debug-overlay')?.classList.remove('hidden');
      }
      
      document.getElementById('close-debug')?.addEventListener('click', () => {
        document.getElementById('debug-overlay')?.classList.add('hidden');
        // Clean URL
        const url = new URL(window.location.href);
        url.searchParams.delete('debug');
        window.history.replaceState({}, '', url);
      });
      
      // Console Easter Egg
      console.log(
        "%c SYSTEM STATUS: OPTIMAL ",
        "background: #00ff9d; color: #000; font-weight: bold; padding: 4px; border-radius: 2px;"
      );
      console.log("Looking for the source? It's open: https://github.com/lightsta1ker/lightsta1ker.github.io");
    </script>
  </body>
</html>
